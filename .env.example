DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
RAZORPAY_KEY_ID=rzp_test_replace
RAZORPAY_KEY_SECRET=replace
GROQ_API_KEY=replace
GROQ_MODEL=openai/gpt-oss-20b

RAZORPAY_WEBHOOK_SECRET=replace-with-your-webhook-signing-secret

# Optional: where the database and uploaded photos are kept (the Docker image uses /data)
# DATA_DIR=
# Optional: staff account created on start if it does not exist
# STAFF_USERNAME=admin
# STAFF_EMAIL=you@example.com
# STAFF_PASSWORD=
